# ---- Datastore ----
DATASTORE=memory                 # memory | oracle
DATA_DIR=data                    # folder holding seed JSON (stores/zones/vendors/catalog)

# ---- API server ----
PORT=3001
HOST=0.0.0.0

# ---- Anthropic (AI Assist). Without a key the /ai routes return safe stubs. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Tunable overrides (defaults live in config/app.config.json) ----
# MARGIN_FLOOR_PCT=15
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=500
# AI_GROUP_SAMPLE_CAP=150

# ---- Oracle 12c (only used when DATASTORE=oracle) ----
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=oracle-host.internal.familydollar.com:1521/RMSPRD
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_RMS_SCHEMA=RMS            # read-only RMS reference schema
ORACLE_APP_PREFIX=FDPM_          # prefix for app tables (must match db/schema.sql)

# ---- Centauri event mirror (by Proxima360). Unset = disabled. ----
# CENTAURI_URL=http://localhost:7771
# CENTAURI_MAX_FANOUT=5000

         WHERE (:from IS NULL OR ACTIVITY_DATE>=TO_DATE(:from,'YYYY-MM-DD')) AND (:to IS NULL OR ACTIVITY_DATE<=TO_DATE(:to,'YYYY-MM-DD'))
           AND ( (:zg IS NULL AND :zid IS NULL)
                 OR (ZONE_GROUP_ID IS NULL AND ZONE_ID IS NULL)
